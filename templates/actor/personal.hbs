<section class="tem-personal">
	<section class="tem-bio__items" aria-labelledby="tem-personal-bonds-heading">
		<header class="tem-bio__items-header">
			<h4 id="tem-personal-bonds-heading">{{localize "Temeraire.ITEM_TYPES.bond"}}</h4>
			<button
				type="button"
				data-action="createPersonalItem"
				data-item-type="bond"
				aria-label="{{localize 'Temeraire.AddBond'}}"
				title="{{localize 'Temeraire.AddBond'}}"
			>
				<i class="fa-solid fa-plus" aria-hidden="true"></i>
			</button>
		</header>
		{{#each itemsByType.bond as |item|}}
			<div class="tem-bio__item">
				<details class="tem-bio__connection-details">
					<summary class="tem-bio__connection-name">{{item.name}}</summary>
					<div class="tem-bio__connection-description">{{item.system.description}}</div>
				</details>
				<button
					type="button"
					data-action="editPersonalItem"
					data-item-id="{{item.id}}"
					aria-label="{{localize 'Temeraire.EditBond'}}: {{item.name}}"
					title="{{localize 'Temeraire.EditBond'}}"
				>
					<i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
				</button>
				<button
					type="button"
					data-action="deletePersonalItem"
					data-item-id="{{item.id}}"
					aria-label="{{localize 'Temeraire.DeleteBond'}}: {{item.name}}"
					title="{{localize 'Temeraire.DeleteBond'}}"
				>
					<i class="fa-solid fa-trash" aria-hidden="true"></i>
				</button>
			</div>
		{{/each}}
	</section>

